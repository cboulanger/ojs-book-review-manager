msgid "emails.brmNewReservation.subject"
msgstr "New work for review reserved"

msgid "emails.brmNewReservation.body"
msgstr ""
"\n"
"\t\t\n"
"\t\t\tNew work for review reserved<br /><br />\n"
"\t\t\tObject for review: {$objectDescription}<br />\n"
"\t\t\tUser: {$userName} ({$userEmail})<br />\n"
"\t\t\t{$reservationDetails}\n"
"\t\t\n"
"\t\t"

msgid "emails.brmNewReservation.description"
msgstr "This email template is used to notify the editor for a reserved OFR item."

msgid "emails.brmCancelReservation.subject"
msgstr "Reservation of a work for review cancelled"

msgid "emails.brmNewReservation.name"
msgstr "Notify the editor for a reserved OFR item."

msgid "emails.brmCancelReservation.body"
msgstr ""
"\n"
"\t\t\n"
"\t\t\tReservation of a work for review cancelled<br /><br />\n"
"\t\t\tObject for review: {$objectDescription}<br />\n"
"\t\t\tUser: {$userName} ({$userEmail})<br />\n"
"\t\t\n"
"\t\t"

msgid "emails.brmCancelReservation.description"
msgstr "This email template is used to notify the editor for a cancelled OFR item reservation."

msgid "emails.brmCancelReservation.name"
msgstr "Notify the editor for a cancelled OFR item reservation."
msgid "emails.brmMessage.name"
msgstr "Message to the reviewer of a reserved work"

msgid "emails.brmMessage.description"
msgstr "Sent by the editors to the person who reserved a work for review."

msgid "emails.brmMessage.subject"
msgstr "Your reserved work for review ({$contextName})"

msgid "emails.brmMessage.body"
msgstr "<p>Dear {$recipientName},</p><p>regarding the work you reserved for review:<br />{$objectDescription}<br />Due date of your review: {$dueDate}</p><p></p><p>Kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmCancelByEditor.name"
msgstr "Reservation cancelled by the editors"

msgid "emails.brmCancelByEditor.description"
msgstr "Notifies the person who reserved a work for review that the editors cancelled the reservation."

msgid "emails.brmCancelByEditor.subject"
msgstr "Your reservation has been cancelled ({$contextName})"

msgid "emails.brmCancelByEditor.body"
msgstr "<p>Dear {$recipientName},</p><p>as we have not heard from you, we have cancelled your reservation of the following work for review:<br />{$objectDescription}</p><p>If you have any questions, please contact us.</p><p>Kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmReminder.name"
msgstr "Reminder before the review is due"

msgid "emails.brmReminder.description"
msgstr "Sent automatically to the person who reserved a work for review, a configurable number of days before the due date."

msgid "emails.brmReminder.subject"
msgstr "Reminder: your review is due on {$dueDate}"

msgid "emails.brmReminder.body"
msgstr "<p>Dear {$recipientName},</p><p>this is a friendly reminder that your review of the following work is due on <strong>{$dueDate}</strong>:<br />{$objectDescription}</p><p>If you need more time, please contact the editors as soon as possible.</p><p>If you cannot write the review after all, please let us know:<br /><a href=\"{$retractUrl}\">{$retractUrl}</a></p><p>Kind regards,<br />{$contextName}</p>"

msgid "emails.brmContractOffer.name"
msgstr "Review agreement: contract offer"

msgid "emails.brmContractOffer.description"
msgstr "Sent to the bidder selected by the book review editor, with a link to the review agreement."

msgid "emails.brmContractOffer.subject"
msgstr "You have been selected to review a work"

msgid "emails.brmContractOffer.body"
msgstr "<p>Dear {$recipientName},</p><p>thank you for your interest. We are happy to offer you the review of the following work:<br />{$objectDescription}</p><p>Please accept the review agreement, or decline the offer, by <strong>{$contractDeadline}</strong>:<br /><a href=\"{$contractUrl}\">{$contractUrl}</a></p><p>Kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmContractOfferAgain.name"
msgstr "Review agreement: offer after a dropout"

msgid "emails.brmContractOfferAgain.description"
msgstr "Sent to a bidder from the kept list after the previously selected reviewer dropped out."

msgid "emails.brmContractOfferAgain.subject"
msgstr "The review of a work you applied for is available again"

msgid "emails.brmContractOfferAgain.body"
msgstr "<p>Dear {$recipientName},</p><p>you applied to review the following work:<br />{$objectDescription}</p><p>The review has become available again, and we would be happy to offer it to you. If you are still interested, please accept the review agreement by <strong>{$contractDeadline}</strong>, or decline the offer:<br /><a href=\"{$contractUrl}\">{$contractUrl}</a></p><p>Kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmContractReminder.name"
msgstr "Reminder about a contract offer"

msgid "emails.brmContractReminder.description"
msgstr "Sent automatically to a selected bidder who has not yet answered the contract offer."

msgid "emails.brmContractReminder.subject"
msgstr "Reminder: please respond to the review offer by {$contractDeadline}"

msgid "emails.brmContractReminder.body"
msgstr "<p>Dear {$recipientName},</p><p>this is a friendly reminder that we have offered you the review of the following work:<br />{$objectDescription}</p><p>Please accept the review agreement, or decline the offer, by <strong>{$contractDeadline}</strong>:<br /><a href=\"{$contractUrl}\">{$contractUrl}</a></p><p>Kind regards,<br />{$contextName}</p>"

msgid "emails.brmBidUnsuccessful.name"
msgstr "Bidder not selected"

msgid "emails.brmBidUnsuccessful.description"
msgstr "Sent to the other bidders once a contract has been accepted. They stay on the list in case the review does not materialise."

msgid "emails.brmBidUnsuccessful.subject"
msgstr "Your application to review a work"

msgid "emails.brmBidUnsuccessful.body"
msgstr "<p>Dear {$recipientName},</p><p>thank you for applying to review the following work:<br />{$objectDescription}</p><p>We have given the review to another applicant this time. We will keep you on our list, and may contact you if the review does not materialise.</p><p>If you would rather be removed from the list, please use this link:<br /><a href=\"{$removeUrl}\">{$removeUrl}</a></p><p>Kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmBidNew.name"
msgstr "New bid (to the book review editor)"

msgid "emails.brmBidNew.description"
msgstr "Sent automatically to the responsible book review editor when someone applies to review a work."

msgid "emails.brmBidNew.subject"
msgstr "New application to review: {$objectDescription}"

msgid "emails.brmBidNew.body"
msgstr "<p>Dear {$recipientName},</p><p>{$bidderName} has applied to review the following work:<br />{$objectDescription}</p><p>Statement:<br />{$bidStatement}</p><p>You can choose among the applicants here: <a href=\"{$deskUrl}\">{$deskUrl}</a></p>"

msgid "emails.brmContractDeclined.name"
msgstr "Contract declined or expired (to the book review editor)"

msgid "emails.brmContractDeclined.description"
msgstr "Sent automatically to the responsible book review editor when a selected bidder declines the contract offer or does not answer in time."

msgid "emails.brmContractDeclined.subject"
msgstr "Review offer not accepted: {$objectDescription}"

msgid "emails.brmContractDeclined.body"
msgstr "<p>Dear {$recipientName},</p><p>{$reviewerName} has not accepted the offer to review the following work:<br />{$objectDescription}</p><p>{$declineReason}</p><p>Please choose another bidder, or reopen bidding: <a href=\"{$deskUrl}\">{$deskUrl}</a></p>"

msgid "emails.brmCopyRequest.name"
msgstr "Review copy request (to the publisher)"

msgid "emails.brmCopyRequest.description"
msgstr "Sent by the book review editor to the publisher contact, with the delivery address (printed copy) or the reviewer's email (electronic copy)."

msgid "emails.brmCopyRequest.subject"
msgstr "Request for a review copy: {$objectDescription}"

msgid "emails.brmCopyRequest.body"
msgstr "<p>Dear {$recipientName},</p><p>{$reviewerName} will review the following work for {$contextName}:<br />{$objectDescription}</p><p>We would be grateful if you could provide a review copy ({$copyType}).</p><p>{$deliveryDetails}</p><p>Once you have sent the copy, please let us know with one click:<br /><a href=\"{$copySentUrl}\">{$copySentUrl}</a></p><p>Thank you very much, and kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmCopySent.name"
msgstr "Review copy sent (to the reviewer)"

msgid "emails.brmCopySent.description"
msgstr "Tells the reviewer that the review copy has been sent by the journal or the publisher."

msgid "emails.brmCopySent.subject"
msgstr "Your review copy is on its way"

msgid "emails.brmCopySent.body"
msgstr "<p>Dear {$recipientName},</p><p>a review copy ({$copyType}) of the following work has been sent to you {$copySource}:<br />{$objectDescription}</p><p>Your review is due on {$dueDate}.</p><p>Once it has arrived, please confirm receipt with one click:<br /><a href=\"{$receivedUrl}\">{$receivedUrl}</a></p><p>Kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmReturnRequest.name"
msgstr "Return of a review copy (to the reviewer)"

msgid "emails.brmReturnRequest.description"
msgstr "Asks the reviewer to return a printed review copy when no review will be written, with the return address."

msgid "emails.brmReturnRequest.subject"
msgstr "Please return the review copy"

msgid "emails.brmReturnRequest.body"
msgstr "<p>Dear {$recipientName},</p><p>as the review of the following work will not be written, we kindly ask you to return the review copy:<br />{$objectDescription}</p><p>Please send it to:<br />{$returnAddress}</p><p>Once you have sent it back, please let us know with one click:<br /><a href=\"{$returnSentUrl}\">{$returnSentUrl}</a></p><p>Thank you, and kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmReturnSent.name"
msgstr "Review copy returned (to the publisher)"

msgid "emails.brmReturnSent.description"
msgstr "Tells the publisher contact that a review copy is on its way back."

msgid "emails.brmReturnSent.subject"
msgstr "Review copy on its way back: {$objectDescription}"

msgid "emails.brmReturnSent.body"
msgstr "<p>Dear {$recipientName},</p><p>unfortunately, the review of the following work will not appear:<br />{$objectDescription}</p><p>The review copy you kindly provided has been sent back to you.</p><p>Once it has arrived, please confirm receipt with one click:<br /><a href=\"{$returnReceivedUrl}\">{$returnReceivedUrl}</a></p><p>Thank you again, and kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmPublisherNotification.name"
msgstr "Review published (to the publisher)"

msgid "emails.brmPublisherNotification.description"
msgstr "Tells the publisher contact that the review has been published, if the publisher asked to be notified."

msgid "emails.brmPublisherNotification.subject"
msgstr "Review published: {$objectDescription}"

msgid "emails.brmPublisherNotification.body"
msgstr "<p>Dear {$recipientName},</p><p>we are pleased to let you know that the review of the following work by {$reviewerName} has been published in {$contextName}:<br />{$objectDescription}</p><p><a href=\"{$reviewUrl}\">{$reviewUrl}</a></p><p>Thank you for providing the review copy, and kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmCopyRequestReminder.name"
msgstr "Review copy request reminder (to the publisher)"

msgid "emails.brmCopyRequestReminder.description"
msgstr "Sent automatically to the publisher contact while a review copy request is unanswered."

msgid "emails.brmCopyRequestReminder.subject"
msgstr "Reminder: request for a review copy: {$objectDescription}"

msgid "emails.brmCopyRequestReminder.body"
msgstr "<p>Dear {$recipientName},</p><p>we recently asked you for a review copy ({$copyType}) of the following work, which {$reviewerName} will review for {$contextName}:<br />{$objectDescription}</p><p>{$deliveryDetails}</p><p>If you have already sent it, please let us know with one click:<br /><a href=\"{$copySentUrl}\">{$copySentUrl}</a></p><p>Kind regards,<br />{$contextName}</p>"

msgid "emails.brmConfirmation.name"
msgstr "Review agreement confirmation (to the reviewer)"

msgid "emails.brmConfirmation.description"
msgstr "Sent automatically to the reviewer after accepting the review agreement, with a link to withdraw."

msgid "emails.brmConfirmation.subject"
msgstr "Your review for {$contextName}: confirmation"

msgid "emails.brmConfirmation.body"
msgstr "<p>Dear {$recipientName},</p><p>thank you for agreeing to review the following work:<br />{$objectDescription}</p><p>{$reservationDetails}</p><p>If you find that you cannot write the review after all, please let us know as early as possible:<br /><a href=\"{$retractUrl}\">{$retractUrl}</a></p><p>Kind regards,<br />{$contextName}</p>"

msgid "emails.brmInvitationReserve.name"
msgstr "Invitation to review (direct reservation)"

msgid "emails.brmInvitationReserve.description"
msgstr "Sent by the book review editor to a person on the invitation list of a work with direct reservation, with a link to reserve the work or decline."

msgid "emails.brmInvitationReserve.subject"
msgstr "Invitation to review: {$objectDescription}"

msgid "emails.brmInvitationReserve.body"
msgstr "<p>Dear {$recipientName},</p><p>we would like to invite you to review the following work for {$contextName}:<br />{$objectDescription}</p><p>If you would like to write the review, please accept the review agreement by <strong>{$invitationDeadline}</strong>. If you cannot write it, please let us know with the same link:<br /><a href=\"{$invitationUrl}\">{$invitationUrl}</a></p><p>Kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmInvitationBid.name"
msgstr "Invitation to apply for a review (bidding)"

msgid "emails.brmInvitationBid.description"
msgstr "Sent by the book review editor to a person on the invitation list of a work offered for bidding, with a link to apply or decline."

msgid "emails.brmInvitationBid.subject"
msgstr "Invitation to apply for a review: {$objectDescription}"

msgid "emails.brmInvitationBid.body"
msgstr "<p>Dear {$recipientName},</p><p>we would like to invite you to apply for the review of the following work for {$contextName}:<br />{$objectDescription}</p><p>The book review editor will choose among the applicants. If you are interested, please apply by <strong>{$invitationDeadline}</strong>. If you are not, please let us know with the same link:<br /><a href=\"{$invitationUrl}\">{$invitationUrl}</a></p><p>Kind regards,<br />{$senderName}<br />{$contextName}</p>"

msgid "emails.brmInvitationDeclined.name"
msgstr "Invitation declined or not answered (to the book review editor)"

msgid "emails.brmInvitationDeclined.description"
msgstr "Sent automatically to the responsible book review editor when an invitee declines the invitation or does not answer in time."

msgid "emails.brmInvitationDeclined.subject"
msgstr "Invitation not accepted: {$objectDescription}"

msgid "emails.brmInvitationDeclined.body"
msgstr "<p>Dear {$recipientName},</p><p>{$inviteeName} will not review the following work:<br />{$objectDescription}</p><p>{$declineReason}</p><p>You can invite someone else on the invitation page: <a href=\"{$invitationListUrl}\">{$invitationListUrl}</a></p>"

msgid "emails.brmInvitationReminder.name"
msgstr "Invitation reminder"

msgid "emails.brmInvitationReminder.description"
msgstr "Sent automatically to an invitee who has not answered, after the number of days set in the plugin settings."

msgid "emails.brmInvitationReminder.subject"
msgstr "Reminder: invitation regarding {$objectDescription}"

msgid "emails.brmInvitationReminder.body"
msgstr "<p>Dear {$recipientName},</p><p>this is a friendly reminder of our invitation regarding the following work:<br />{$objectDescription}</p><p>Please let us know by <strong>{$invitationDeadline}</strong> whether you would like to take it on:<br /><a href=\"{$invitationUrl}\">{$invitationUrl}</a></p><p>Kind regards,<br />{$contextName}</p>"

msgid "emails.brmInvitationExhausted.name"
msgstr "Invitation list exhausted (to the book review editor)"

msgid "emails.brmInvitationExhausted.description"
msgstr "Sent automatically to the responsible book review editor when a sequential invitation round reaches the end of the list without a reservation."

msgid "emails.brmInvitationExhausted.subject"
msgstr "Invitation round without result: {$objectDescription}"

msgid "emails.brmInvitationExhausted.body"
msgstr "<p>Dear {$recipientName},</p><p>everyone on the invitation list for the following work has declined or not answered:<br />{$objectDescription}</p><p>You can add more people and continue the round, or stop it: <a href=\"{$invitationListUrl}\">{$invitationListUrl}</a></p>"

msgid "emails.brmReviewEssayChanged.name"
msgstr "Review essay changed (to the reviewer)"

msgid "emails.brmReviewEssayChanged.description"
msgstr "Sent by the book review editor to the reviewer of a review essay when works are added to it or removed from it, or when the reviewer's agreement for one work becomes a review essay."

msgid "emails.brmReviewEssayChanged.subject"
msgstr "Your review essay for {$journalName}: the list of works has changed"

msgid "emails.brmReviewEssayChanged.body"
msgstr "<p>Dear {$reviewerName},</p><p>the review essay you agreed to write now covers these works:<br />{$objectDescription}</p><p>Due date: {$dueDate}</p><p>If you have any questions, please contact us.</p><p>Kind regards,<br />{$journalName}</p>"

msgid "emails.brmDueDateChanged.name"
msgstr "Due date changed (to the reviewer)"

msgid "emails.brmDueDateChanged.description"
msgstr "Sent by the book review editor to the reviewer when the due date of the review has been changed, with the link to the submission page."

msgid "emails.brmDueDateChanged.subject"
msgstr "New due date for your review: {$dueDate}"

msgid "emails.brmDueDateChanged.body"
msgstr "<p>Dear {$recipientName},</p><p>the due date of your review of the following work has been changed from {$previousDueDate} to <strong>{$dueDate}</strong>:<br />{$objectDescription}</p><p>When your review is ready, please submit it here:<br /><a href=\"{$submissionUrl}\">{$submissionUrl}</a></p><p>Kind regards,<br />{$senderName}<br />{$contextName}</p>"
